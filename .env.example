# Copy to .env (scripts/setup.sh does this for you and fills in the random secrets).

# --- Fill these in -------------------------------------------------------------------

# Anthropic API key for the AI agent: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Meta / WhatsApp Cloud API (see README, "Connect WhatsApp")
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_ID=
META_APP_SECRET=

# Public HTTPS address that forwards to n8n on port 5678 (ngrok / Cloudflare tunnel / your domain).
# No trailing slash. Meta cannot deliver WhatsApp messages without this.
PUBLIC_URL=

# --- Generated by scripts/setup.sh ---------------------------------------------------

POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
NOTIFY_SECRET=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Optional ------------------------------------------------------------------------

TIMEZONE=Asia/Karachi
N8N_HOST_PORT=5678
DASHBOARD_HOST_PORT=3000
